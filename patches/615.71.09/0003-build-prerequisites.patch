--- /dev/null
+++ b/kernel-open/gpu-ext/check-prerequisites.sh
@@ -0,0 +1,25 @@
+#!/bin/sh
+# Validate the target kernel without invoking a compiler or modifying it.
+set -eu
+
+kernel_output=${1:?Usage: check-prerequisites.sh KERNEL_OUTPUT}
+config_file=$kernel_output/.config
+
+if [ ! -r "$config_file" ]; then
+    printf 'gpu_ext: missing target kernel configuration: %s\n' "$config_file" >&2
+    exit 1
+fi
+
+for option in CONFIG_BPF_SYSCALL CONFIG_BPF_JIT CONFIG_DEBUG_INFO_BTF CONFIG_DEBUG_INFO_BTF_MODULES; do
+    if ! grep -qx "$option=y" "$config_file"; then
+        printf 'gpu_ext: target kernel requires %s=y\n' "$option" >&2
+        exit 1
+    fi
+done
+
+if [ ! -s "$kernel_output/vmlinux" ]; then
+    printf 'gpu_ext: matching target vmlinux is required for module BTF: %s/vmlinux\n' "$kernel_output" >&2
+    exit 1
+fi
+
+printf 'gpu_ext: target kernel configuration and vmlinux prerequisites are present.\n'
