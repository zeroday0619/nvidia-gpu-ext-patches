+/* Record one callback-local prefetch request without narrowing its endpoints. */
+__bpf_kfunc int bpf_gpu_set_prefetch_region(uvm_bpf_prefetch_decision_t *decision_ctx,
+					    u64 first,
+					    u64 outer)
+{
+	if (!decision_ctx)
